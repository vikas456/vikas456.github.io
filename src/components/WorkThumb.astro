---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Work card visual.
 *
 * TO USE A REAL SCREENSHOT: drop a file named <slug>.png|jpg|webp into
 * src/assets/work/ — e.g. src/assets/work/meta-shop.png — and it is picked up
 * automatically on the next build, optimised to WebP and served responsively.
 * No code change needed. Until then the hand-drawn placeholder below renders.
 * Supply images at roughly 1360x528 (2x of the 680x264 display size).
 */
interface Props { slug: string; alt: string; featured?: boolean; }
const { slug, alt, featured = false } = Astro.props;

const supplied = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/work/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const match = Object.entries(supplied).find(([path]) =>
  path.split('/').pop()?.replace(/\.[^.]+$/, '') === slug,
);

const PLACEHOLDERS: Record<string, string> = {
  'meta-shop': `<svg viewBox="0 0 340 132" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><pattern id="g4127" width="17" height="17" patternUnits="userSpaceOnUse"><path d="M17 0H0v17" fill="none" stroke="#232B3A" stroke-width=".6" opacity=".5"/></pattern></defs><rect width="340" height="132" fill="#0C0F15"/><rect width="340" height="132" fill="url(#g4127)"/><g transform="translate(170 60)"><rect x="-62" y="-15" width="52" height="30" rx="11" fill="none" stroke="#FFB86B" stroke-width="2.6"/><rect x="10" y="-15" width="52" height="30" rx="11" fill="none" stroke="#FFB86B" stroke-width="2.6"/><path d="M-10 -3q10 -7 20 0" fill="none" stroke="#FFB86B" stroke-width="2.6"/><circle cx="-36" cy="0" r="5" fill="#FFB86B" opacity=".55"/><circle cx="36" cy="0" r="5" fill="#FFB86B" opacity=".55"/></g><g transform="translate(0 4)"><rect x="238" y="86" width="13" height="20" rx="2.5" fill="#FFB86B" opacity=".35"/><rect x="256" y="74" width="13" height="32" rx="2.5" fill="#FFB86B" opacity=".55"/><rect x="274" y="58" width="13" height="48" rx="2.5" fill="#FFB86B"/><path d="M238 78 L293 46" stroke="#FFB86B" stroke-width="2" fill="none" stroke-linecap="round"/><path d="M282 46h11v11" stroke="#FFB86B" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g></svg>`,
  'accounts-center': `<svg viewBox="0 0 340 132" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><pattern id="g6635" width="17" height="17" patternUnits="userSpaceOnUse"><path d="M17 0H0v17" fill="none" stroke="#232B3A" stroke-width=".6" opacity=".5"/></pattern></defs><rect width="340" height="132" fill="#0C0F15"/><rect width="340" height="132" fill="url(#g6635)"/><g><rect x="46" y="18" width="30" height="30" rx="8" fill="none" stroke="#6E8BFF" stroke-width="1.8" opacity=".75"/><rect x="46" y="54" width="30" height="30" rx="8" fill="none" stroke="#6E8BFF" stroke-width="1.8" opacity=".75"/><rect x="86" y="18" width="30" height="30" rx="8" fill="none" stroke="#6E8BFF" stroke-width="1.8" opacity=".75"/><rect x="86" y="54" width="30" height="30" rx="8" fill="none" stroke="#6E8BFF" stroke-width="1.8" opacity=".75"/><path d="M120 40 C150 40 150 66 182 66" fill="none" stroke="#6E8BFF" stroke-width="1.4" opacity=".55"/><path d="M120 76 C150 76 150 66 182 66" fill="none" stroke="#6E8BFF" stroke-width="1.4" opacity=".55"/><path d="M80 33 C120 33 140 66 182 66" fill="none" stroke="#6E8BFF" stroke-width="1.4" opacity=".35"/><path d="M80 83 C120 83 140 66 182 66" fill="none" stroke="#6E8BFF" stroke-width="1.4" opacity=".35"/><rect x="182" y="24" width="118" height="84" rx="11" fill="#12161D" stroke="#232B3A" stroke-width="1.4"/><rect x="196" y="40" width="60" height="5" rx="2.5" fill="#59647A" opacity=".5"/><rect x="266" y="36" width="22" height="12" rx="6" fill="#6E8BFF" opacity=".22"/><circle cx="282" cy="42" r="4" fill="#6E8BFF"/><rect x="196" y="64" width="60" height="5" rx="2.5" fill="#59647A" opacity=".5"/><rect x="266" y="60" width="22" height="12" rx="6" fill="#6E8BFF" opacity=".22"/><circle cx="272" cy="66" r="4" fill="#6E8BFF"/><rect x="196" y="88" width="60" height="5" rx="2.5" fill="#59647A" opacity=".5"/><rect x="266" y="84" width="22" height="12" rx="6" fill="#6E8BFF" opacity=".22"/><circle cx="282" cy="90" r="4" fill="#6E8BFF"/></g></svg>`,
  'boosted-listings': `<svg viewBox="0 0 340 132" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><pattern id="g3401" width="17" height="17" patternUnits="userSpaceOnUse"><path d="M17 0H0v17" fill="none" stroke="#232B3A" stroke-width=".6" opacity=".5"/></pattern></defs><rect width="340" height="132" fill="#0C0F15"/><rect width="340" height="132" fill="url(#g3401)"/><rect x="52" y="26" width="106" height="80" rx="11" fill="#12161D" stroke="#232B3A" stroke-width="1.4"/><rect x="64" y="38" width="82" height="34" rx="7" fill="#59647A" opacity=".2"/><rect x="64" y="80" width="56" height="6" rx="3" fill="#59647A" opacity=".5"/><rect x="64" y="92" width="34" height="6" rx="3" fill="#59647A" opacity=".3"/><g transform="translate(212 66)"><circle r="34" fill="none" stroke="#FFB86B" stroke-width="1.2" opacity=".3"/><circle r="24" fill="#FFB86B" opacity=".13"/><path d="M0 -13 L11 2 H4 v11 H-4 V2 h-7 Z" fill="#FFB86B"/></g><path d="M262 92 L292 92 M262 78 L302 78 M262 64 L286 64" stroke="#FFB86B" stroke-width="2.4" opacity=".35" stroke-linecap="round"/></svg>`,
  'messenger': `<svg viewBox="0 0 340 132" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><pattern id="g2146" width="17" height="17" patternUnits="userSpaceOnUse"><path d="M17 0H0v17" fill="none" stroke="#232B3A" stroke-width=".6" opacity=".5"/></pattern></defs><rect width="340" height="132" fill="#0C0F15"/><rect width="340" height="132" fill="url(#g2146)"/><path d="M56 30h96a12 12 0 0 1 12 12v34a12 12 0 0 1-12 12h-62l-20 16v-16h-14a12 12 0 0 1-12-12V42a12 12 0 0 1 12-12Z" fill="#12161D" stroke="#232B3A" stroke-width="1.5"/><rect x="72" y="48" width="64" height="6" rx="3" fill="#59647A" opacity=".55"/><rect x="72" y="62" width="44" height="6" rx="3" fill="#59647A" opacity=".33"/><path d="M182 66h56" stroke="#6E8BFF" stroke-width="2" stroke-dasharray="5 5" opacity=".6"/><path d="M230 57l11 9-11 9" fill="none" stroke="#6E8BFF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><rect x="250" y="36" width="52" height="60" rx="12" fill="none" stroke="#6E8BFF" stroke-width="1.5" opacity=".8"/><rect x="262" y="54" width="28" height="5" rx="2.5" fill="#6E8BFF" opacity=".5"/><rect x="262" y="66" width="18" height="5" rx="2.5" fill="#6E8BFF" opacity=".3"/></svg>`,
  'redraft': `<svg viewBox="0 0 340 132" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><pattern id="g9065" width="17" height="17" patternUnits="userSpaceOnUse"><path d="M17 0H0v17" fill="none" stroke="#232B3A" stroke-width=".6" opacity=".5"/></pattern></defs><rect width="340" height="132" fill="#0C0F15"/><rect width="340" height="132" fill="url(#g9065)"/><g><rect x="46" y="30" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".5"/><rect x="71" y="30" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".5"/><rect x="96" y="30" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".5"/><rect x="121" y="30" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".5"/><rect x="46" y="52" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".3"/><rect x="71" y="52" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".3"/><rect x="96" y="52" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".3"/><rect x="121" y="52" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".3"/><rect x="46" y="74" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".18"/><rect x="71" y="74" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".18"/><rect x="96" y="74" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".18"/><rect x="121" y="74" width="20" height="13" rx="3" fill="#6E8BFF" opacity=".18"/></g><path d="M186 104 V34 M186 104 H302" stroke="#232B3A" stroke-width="1.3"/><path d="M196 92 L214 80 L232 84 L250 66 L268 58 L286 44" fill="none" stroke="#FFB86B" stroke-width="1.6" opacity=".45"/><circle cx="196" cy="92" r="4" fill="#FFB86B"/><circle cx="214" cy="80" r="4" fill="#FFB86B"/><circle cx="232" cy="84" r="4" fill="#FFB86B"/><circle cx="250" cy="66" r="4" fill="#FFB86B"/><circle cx="268" cy="58" r="4" fill="#FFB86B"/><circle cx="286" cy="44" r="4" fill="#FFB86B"/></svg>`,
  'uteats': `<svg viewBox="0 0 340 132" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><pattern id="g3492" width="17" height="17" patternUnits="userSpaceOnUse"><path d="M17 0H0v17" fill="none" stroke="#232B3A" stroke-width=".6" opacity=".5"/></pattern></defs><rect width="340" height="132" fill="#0C0F15"/><rect width="340" height="132" fill="url(#g3492)"/><g transform="translate(112 60)"><path d="M0 -30c-13 0-23 10-23 23 0 17 23 37 23 37s23-20 23-37c0-13-10-23-23-23Z" fill="none" stroke="#6E8BFF" stroke-width="2.4"/><circle cy="-7" r="8" fill="#6E8BFF" opacity=".35"/></g><g transform="translate(232 66)"><circle r="32" fill="none" stroke="#6E8BFF" stroke-width="1.6" opacity=".55"/><path d="M0 -18v18l13 8" fill="none" stroke="#6E8BFF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></g><rect x="40" y="104" width="34" height="6" rx="3" fill="#6E8BFF" opacity=".4"/><rect x="82" y="104" width="22" height="6" rx="3" fill="#6E8BFF" opacity=".22"/></svg>`,
};
---
<div class="thumb">
  {match ? (
    <Image src={match[1].default} alt={alt} widths={[400, 680, 1360]}
           sizes={featured ? '(max-width: 1000px) 100vw, 680px' : '(max-width: 1000px) 100vw, 336px'}
           format="webp" quality={72} loading="lazy" decoding="async" />
  ) : (
    <Fragment set:html={PLACEHOLDERS[slug]} />
  )}
</div>
