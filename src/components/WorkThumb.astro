---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Work card visual.
 *
 * TO USE A REAL SCREENSHOT: drop a file named <slug>.png|jpg|webp into
 * src/assets/work/ — e.g. src/assets/work/meta-shop.png — and it is picked up
 * automatically on the next build, optimised to WebP and served responsively.
 * No code change needed. Until then the hand-drawn placeholder below renders.
 * Supply images at roughly 1360x528 (2x of the 680x264 display size).
 */
interface Props { slug: string; alt: string; featured?: boolean; }
const { slug, alt, featured = false } = Astro.props;

const supplied = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/work/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const match = Object.entries(supplied).find(([path]) =>
  path.split('/').pop()?.replace(/\.[^.]+$/, '') === slug,
);

