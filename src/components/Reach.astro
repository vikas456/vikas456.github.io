---
import { reachNodes } from '../data/content';

const altText =
  'Diagram of the Meta products Vikas has helped build and the projects behind each: ' +
  reachNodes
    .map((n) => `${n.label} — ${n.did} ${n.metric}. Projects: ${n.children.map((c) => c.label).join(', ')}`)
    .join('. ') +
  '.';
---
<section class="reach" aria-labelledby="reach-h">
  <h2 id="reach-h" class="sr-only">Products I've helped build</h2>
  <div class="inner">
    <div class="reach-frame">
      <div class="reach-cap">
        <span class="lbl">Products I've helped build</span>
        <div class="reach-legend">
          <span><i style="background:#6E8BFF"></i>Products I've built</span>
          <span><i style="background:#FFB86B"></i>Revenue I've grown</span>
        </div>
      </div>
      <canvas id="reach-canvas" role="img" aria-label={altText}></canvas>
      <div class="reach-controls">
        <button type="button" id="reach-out" aria-label="Zoom out">&minus;</button>
        <button type="button" id="reach-in" aria-label="Zoom in">+</button>
        <button type="button" id="reach-reset" aria-label="Reset the view">Reset</button>
      </div>
      <div class="reach-hint">Click a node &middot; drag to pan</div>
      <div id="reach-tip" role="status"></div>
    </div>
  </div>

  <!-- Text equivalent: keeps the diagram's content in the DOM for search
       engines and screen readers, since canvas pixels are invisible to both. -->
  <ul class="sr-only">
    {reachNodes.map((n) => (
      <li>
        {n.label}: {n.did} {n.metric}.
        <ul>
          {n.children.map((c) => <li>{c.label} — {c.detail}</li>)}
        </ul>
      </li>
    ))}
  </ul>
</section>

<script>
  import { reachNodes } from '../data/content';
  import { initReachDiagram } from '../scripts/reach';
  initReachDiagram(reachNodes);
</script>
